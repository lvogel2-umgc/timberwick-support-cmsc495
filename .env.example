# Author: Luke Vogel
# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Long random string used to sign login tokens (at least 32 characters).
SECRET_KEY=replace-with-a-long-random-string

# Defaults to a local SQLite file named support.db when not set.
DATABASE_URL=sqlite:///./support.db

# How long a login token stays valid, in minutes.
TOKEN_MINUTES=30

# AI answers scoring below this are escalated to an agent instead.
CONFIDENCE_THRESHOLD=0.30

# Passwords for the demo accounts created by python -m app.seed
DEMO_CUSTOMER_PASSWORD=customer-demo-pass
DEMO_AGENT_PASSWORD=agent-demo-pass
